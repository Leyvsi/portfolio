*.key
*.p12
*.pfx

# Bases locales et journaux SQLite
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Sauvegardes : conserver les migrations SQL visibles
/backups/
/sauvegardes/
*_backup.sql
*_backup.sql.gz
backup_*.sql
backup_*.sql.gz
*.sql.bak
*.bak

# Telechargement identifie pendant l'audit
